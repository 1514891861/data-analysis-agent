---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	load_data(load_data)
	planner(planner)
	coder(coder)
	reviewer(reviewer)
	executor(executor)
	repair(repair)
	visualizer(visualizer)
	reporter(reporter)
	__end__([<p>__end__</p>]):::last
	__start__ --> load_data;
	coder --> reviewer;
	executor -.-> repair;
	executor -.-> visualizer;
	load_data --> planner;
	planner --> coder;
	repair --> reviewer;
	reviewer -. &nbsp;pass&nbsp; .-> executor;
	reviewer -.-> repair;
	visualizer --> reporter;
	reporter --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
